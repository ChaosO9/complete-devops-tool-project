# ==============================================================================
# OPTION 2: Cost-Free Public-Only VPC Architecture (No NAT Gateway / No EIP)
# ==============================================================================
# To use this configuration instead of the NAT Gateway setup:
# 1. Rename 'vpc.tf' to 'vpc.tf.disabled'
# 2. Rename this file 'vpc2.tf.disabled' to 'vpc.tf'
# 3. In compute.tf, point instances to 'aws_subnet.devops_public_subnet.id'
# ==============================================================================

resource "aws_vpc" "devops_vpc" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name = "devops-vpc-public-only"
  }
}

resource "aws_subnet" "devops_public_subnet" {
  vpc_id                  = aws_vpc.devops_vpc.id
  cidr_block              = "10.0.1.0/24"
  map_public_ip_on_launch = true
  availability_zone       = "${var.aws_region}a"

  tags = {
    Name = "devops-public-subnet"
  }
}

resource "aws_internet_gateway" "devops_igw" {
  vpc_id = aws_vpc.devops_vpc.id

  tags = {
    Name = "devops-igw"
  }
}

resource "aws_route_table" "devops_public_rt" {
  vpc_id = aws_vpc.devops_vpc.id

  tags = {
    Name = "devops-public-route-table"
  }
}

resource "aws_route" "devops_public_route" {
  route_table_id         = aws_route_table.devops_public_rt.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.devops_igw.id
}

resource "aws_route_table_association" "devops_public_rta" {
  subnet_id      = aws_subnet.devops_public_subnet.id
  route_table_id = aws_route_table.devops_public_rt.id
}
